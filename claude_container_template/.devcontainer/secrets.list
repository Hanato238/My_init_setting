# devcontainer に取り込む環境変数名を 1 行 1 つ書く（値は書かない）。
#
#   - ホストの環境変数にあれば、`llm` 関数が起動のたびに docker exec -e で注入する（優先）。
#     Windows では SecretStore の値がプロファイルで環境変数に展開されている。
#     .devcontainer が無いディレクトリでは、テンプレートのこのリストが既定として使われる。
#   - 無ければ bws のシークレット（key == この名前）から取得する。
#     こちらは ~/.secrets（chmod 600）に書かれ、ログインシェルで自動 source される。
#
# bws 側を反映するには .devcontainer/load-secrets.sh を実行（bws-login 実行時にも自動で走る）。
# `#` で始まる行と空行は無視。環境変数として無効な名前（英字/_ 始まり + 英数字/_ のみ）は警告してスキップ。
#
# 使う名前だけ行頭の `#` を外す。以下はよく使う候補のカタログ（すべて既定でコメントアウト）。
# [shared] 印は shared/mcp_config.json ・ shared/mcp.d/*.json の MCP サーバーが参照する変数。

# --- LLM / AI プロバイダ ---
# OPENAI_API_KEY
# ANTHROPIC_API_KEY            # devcontainer では docker-compose.yml の environment: が供給。汎用コンテナで API キーを使うなら有効化
# GEMINI_API_KEY
PERPLEXITY_API_KEY           # [shared] perplexity MCP

# --- 検索 / Web 取得（MCP や CLI から利用） ---
CONTEXT7_API_KEY             # [shared] context7 MCP

# --- 開発 / VCS ---
GITHUB_TOKEN
GH_TOKEN
GITHUB_MCP_PAT               # [shared] github MCP（@modelcontextprotocol/server-github）

# --- Google / Cloud ---
GWS_MCP_CLIENT_ID                 # [shared] google_workspace MCP（GOOGLE_OAUTH_CLIENT_ID に対応）
GWS_MCP_CLIENT_SECRET             # [shared] google_workspace MCP（GOOGLE_OAUTH_CLIENT_SECRET に対応）
GCP_PROJECT_ID         # [shared] gcp-hardening-* MCP。非シークレット（プロジェクト ID）
GEMINI_MODEL                 # [shared] gemini-cli MCP。非シークレット（モデル名）

# --- 生産性 / コマース ---
TODOIST_API_KEY              # [shared] todoist MCP
RAINDROP_ACCESS_TOKEN        # [shared] raindrop MCP
KEEPA_API_KEY                # [shared] keepa MCP

# --- 観測 / その他 ---
# LANGFUSE_PUBLIC_KEY
# LANGFUSE_SECRET_KEY
# HF_TOKEN
